@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <h2>Login do Sistema</h2>
    <form asp-action="Login" method="post">
        <div class="mb-3">
            <label text="E-mail de Acesso" class="form-label">E-mail:</label>
            <input type="email" name="Email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label text="Senha do Sistema" class="form-label">Senha:</label>
            <input type="password" name="Senha" class="form-control" required />
        </div>
        <button type="submit" name="btnEntrar" text="Entrar no Sistema" class="btn btn-primary">Entrar</button>
    </form>
</div>